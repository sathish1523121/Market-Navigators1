# Copy to .env and fill in. Nothing here is required for basic demo mode
# (the app runs with sensible defaults / DEMO_KEY), but you'll want all
# of it for production use.

ENV=development

# --- Redis / Celery (only needed for the async pipeline) ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase ("single source of truth") ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Open Food Facts ---
# No key required. Set a real contact email in the User-Agent per OFF's
# integration guidelines.
OPENFOODFACTS_USER_AGENT=ImmuneMarketInsights/1.0 (contact: you@example.com)

# --- USDA FoodData Central ---
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY works but is heavily rate limited.
USDA_FDC_API_KEY=DEMO_KEY

# --- LLM (optional, used for higher-quality intent classification / claims) ---
# Get a FREE Gemini key at: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth (placeholder until you wire up a real provider) ---
AUTH_ENABLED=false
JWT_SECRET=dev-secret-change-me

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
